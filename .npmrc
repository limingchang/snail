# ── store ────────────────────────────────────────────────────────────────────
#
# The store intentionally lives *outside* this repository on the machine where the
# workspace was rebuilt, because that store (`D:\.pnpm-store`) already held every
# dependency the lockfile needs. The alternative — a repository-local store, which
# is what the line below used to say — meant re-downloading roughly 5.9 GB over a
# registry that resets connections from this network.
#
# This is deliberately an absolute path and is therefore machine-specific. On a
# machine with a populated global store, delete this line and pnpm will use its own
# default. On a machine where nothing is cached yet, point it at `.pnpm-store` to
# keep the store inside the repository:
#
#     store-dir=.pnpm-store
#
# Note that pnpm refuses to install when the configured store disagrees with the
# one `node_modules/.modules.yaml` was linked from, so changing this requires
# deleting `node_modules` and installing again.
store-dir=D:\.pnpm-store

# ── metadata cache ───────────────────────────────────────────────────────────
#
# This one stays inside the repository and matters more than the store does.
# pnpm's metadata cache defaults to `%LOCALAPPDATA%\pnpm-cache` on Windows. A
# confined build environment denies that write, so every registry metadata request
# fails with EPERM and pnpm retries on a backoff — which presents exactly like a
# hung install, with no error and no progress.
cache-dir=.pnpm-cache

# Deterministic installs for a published library.
save-exact=true
strict-peer-dependencies=false
auto-install-peers=true

# Workspace packages are linked, not hoisted, so `workspace:*` deps resolve.
hoist-workspace-packages=true
link-workspace-packages=true

# Allow the one transitive dependency that genuinely needs a postinstall step.
# esbuild links its platform binary there; everything else is pure JS.
only-built-dependencies[]=esbuild
