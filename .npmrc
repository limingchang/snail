# Keep the pnpm store inside the repository so builds work in sandboxes that
# cannot write outside the project root.
store-dir=.pnpm-store

# Deterministic installs for a published library.
save-exact=true
strict-peer-dependencies=false
auto-install-peers=true

# Workspace packages are linked, not hoisted, so `workspace:*` deps resolve.
hoist-workspace-packages=true
link-workspace-packages=true

# Allow the one transitive dependency that genuinely needs a postinstall step.
# esbuild links its platform binary there; everything else is pure JS.
only-built-dependencies[]=esbuild
