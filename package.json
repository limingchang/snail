{
  "name": "@snail-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the @snail-js tooling family: a decorator-driven HTTP client, an OpenAPI code generator, a Tiptap contract editor and a Vue component library.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:libs": "pnpm --filter @snail-js/vue --filter @snail-js/editor run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "test:cov": "pnpm -r --filter \"./packages/**\" run test:cov",
    "verify": "pnpm --filter @snail-js/api run verify",
    "docs:dev": "pnpm --filter @snail-js/docs run docs:dev",
    "docs:build": "pnpm run build:libs && pnpm --filter @snail-js/docs run docs:build",
    "docs:preview": "pnpm --filter @snail-js/docs run docs:preview",
    "docs:check": "pnpm --filter @snail-js/docs run check",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build && pnpm run verify"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}